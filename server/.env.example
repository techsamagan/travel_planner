# Copy this file to .env and fill in values.

# Port the Express API listens on
PORT=5000

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Path to the SQLite database file (defaults to server/wanderwise.db).
DB_PATH=

# Optional: enable real AI itineraries. If omitted, a built-in mock generator is used.
ANTHROPIC_API_KEY=

# Model to use when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-6
