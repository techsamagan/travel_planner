# Copy this file to .env and fill in values.

# Port the Express API listens on (local dev only). Vite proxies /api here.
PORT=5050

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Postgres connection string. On Vercel this is injected automatically when you
# add a Postgres/Neon store (POSTGRES_URL). Locally, point it at any Postgres
# instance (local, Neon, Supabase, etc.).
POSTGRES_URL=

# Optional: enable real AI itineraries. If omitted, a built-in mock generator is used.
OPENAI_API_KEY=

# Model to use when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini
